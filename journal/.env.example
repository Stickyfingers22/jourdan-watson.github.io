# Copy to .env.local (never commit real values).
# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Comma-separated list of emails allowed to use JOURNAL (defence in depth on
# top of disabling sign-ups in Supabase). Leave blank only for local testing.
JOURNAL_ALLOWED_EMAILS=you@example.com

# Free-tier thresholds used by the Settings > Usage page (MB).
JOURNAL_DB_LIMIT_MB=500
JOURNAL_STORAGE_LIMIT_MB=1024
